@page "/"
@using System.Net.Http.Json
@using Core
@inject HttpClient Http

<PageTitle>Tøjklubben</PageTitle>

<div class="home-page">

    <!-- TOP: Velkomst, knapper og billede -->
    <div class="welcome-container">

        <!-- VENSTRE: Velkomsttekst -->
        <div class="welcome-text">
            <h1>Velkommen til Tøjklubben!</h1>
            <p>Del, genbrug og lån tøj med resten af klubben!</p>
        </div>

        <!-- MIDTEN: Knapper -->
        <div class="welcome-buttons">
            <button class="btn btn-primary" @onclick="ShowRegisterForm">
                Bliv en del af klubben
            </button>

            <button class="btn btn-outline-primary" @onclick="ShowClothesForm">
                Tilføj tøj
            </button>
        </div>

        <!-- HØJRE: Billede -->
        <img src="images/ClothesClub.png"
             alt="Illustration af tøj"
             class="welcome-image" />
    </div>

    <!-- FORMULAR: Bliv medlem -->
    @if (showRegisterForm)
    {
        <div class="form-box">
            <input class="form-control mb-2" placeholder="Navn" @bind="newMember.Name" />
            <input class="form-control mb-2" placeholder="Email" @bind="newMember.EmailAddress" />
            <input class="form-control mb-2" placeholder="Telefon" @bind="newMember.Phonenumber" />
            <button class="btn borrow-button" @onclick="RegisterMember">Gem</button>
        </div>
    }

    <!-- FORMULAR: Tilføj tøj -->
    @if (showClothesForm)
    {
        <div class="form-box">
            <select class="form-select mb-2" @bind="selectedMemberID">
                <option value="0">Vælg medlem</option>
                @foreach (ClubMember m in members)
                {
                    <option value="@m.ClubMemberId">@m.Name</option>
                }
            </select>
            <input class="form-control mb-2" placeholder="Type" @bind="newClothes.Type" />
            <input class="form-control mb-2" placeholder="Størrelse" @bind="newClothes.Size" />
            <input class="form-control mb-2" placeholder="Farve" @bind="newClothes.Color" />
            <input class="form-control mb-2" placeholder="Beskrivelse" @bind="newClothes.Description" />
            <button class="btn borrow-button" @onclick="AddClothes">Gem</button>
        </div>
    }

    <!-- FORMULAR: Lån tøj -->
    @if (selectedItemID != null)
    {
        <div class="form-box">
            <select class="form-select mb-2" @bind="borrowerID">
                <option value="0">Hvem låner?</option>
                @foreach (ClubMember m in members)
                {
                    <option value="@m.ClubMemberId">@m.Name</option>
                }
            </select>
            <button class="btn borrow-button" @onclick="BorrowClothes">Lån</button>
        </div>
    }

    <!-- NEDERST: Medlemmer og tøj -->
    <div class="container-box">

        <!-- Venstre side: Klubmedlemmer -->
        <div class="member-box">
            <h3>Klubmedlemmer</h3>
            <hr />
            @foreach (ClubMember member in members)
            {
                <div class="member-row">
                    <span class="member-name">@member.Name</span>
                    <span class="member-email">@member.EmailAddress</span>
                </div>
            }
        </div>

        <!-- Højre side: Alt tøj -->
        <div class="clothes-box">
            <h3>Alt tøj i låneklubben</h3>
            <hr />
            <div class="clothes-grid">
                @foreach (Clothes item in clothes)
                {
                    <div class="card">
                        <div class="card-body">
                            <h5>@item.Type</h5>
                            <p>Str. @item.Size · @item.Color</p>
                            @if (item.BorrowedByMemberId != null)
                            {
                                <span class="badge bg-danger">Udlånt</span>
                                <p class="due-date">
                                    Ledig igen: @item.DueDate?.ToString("dd.MM.yyyy")
                                </p>
                            }
                            else
                            {
                                <span class="badge bg-success">Ledig</span>
                                <button class="btn borrow-button" @onclick="() => ShowBorrowForm(item.ItemID)">
                                    Lån tøj
                                </button>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@code {
    // Adressen på backenden
    const string apiUrl = "http://localhost:5049";

    // Data fra backend
    private List<ClubMember> members = new();
    private List<Clothes> clothes = new();

    // Det, der udfyldes i formularerne
    private ClubMember newMember = new();
    private Clothes newClothes = new();
    private int selectedMemberID;   // hvem ejer tøjet
    private int borrowerID;         // hvem låner tøjet

    // Hvilken formular der vises
    private bool showRegisterForm = false;
    private bool showClothesForm = false;
    private int? selectedItemID = null;   // tøjet der skal lånes

    // Kaldes automatisk, når siden åbner
    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    // Henter medlemmer og tøj fra backend
    private async Task LoadData()
    {
        members = await Http.GetFromJsonAsync<List<ClubMember>>($"{apiUrl}/clubmember") ?? new();
        clothes = await Http.GetFromJsonAsync<List<Clothes>>($"{apiUrl}/clothes") ?? new();
    }

    // Vis formularer
    private void ShowRegisterForm()
    {
        showRegisterForm = true;
    }

    private void ShowClothesForm()
    {
        showClothesForm = true;
    }

    private void ShowBorrowForm(int itemID)
    {
        selectedItemID = itemID;
    }

    // Gem nyt medlem
    private async Task RegisterMember()
    {
        await Http.PostAsJsonAsync($"{apiUrl}/clubmember", newMember);
        newMember = new();
        showRegisterForm = false;
        await LoadData();
    }

    // Gem nyt tøj
    private async Task AddClothes()
    {
        await Http.PostAsJsonAsync($"{apiUrl}/clubmember/{selectedMemberID}/clothes", newClothes);
        newClothes = new();
        showClothesForm = false;
        await LoadData();
    }

    // Lån tøj i 14 dage
    private async Task BorrowClothes()
    { 
        // Stopper, hvis der ikke er valgt en låner ("Hvem låner?" har værdien 0)
        if (borrowerID == 0)
        {
            return;
        }
        string dueDate = DateTime.Today.AddDays(14).ToString("yyyy-MM-dd");

        //Gemmer svaret fra backend, så vi kan tjekke om udlånet lykkedes
        HttpResponseMessage response = await Http.PutAsync(
            $"{apiUrl}/clothes/{selectedItemID}/borrow?memberId={borrowerID}&dueDate={dueDate}", null);
    
        // Lukker kun formularen, hvis udlånet gik godt.
        // Ellers bliver den stående, så man kan se, at noget gik galt.
        if (response.IsSuccessStatusCode)
        {
            selectedItemID = null;
            borrowerID = 0; //Nulstiller valget til næste gang
        }
        await LoadData();
    }
}