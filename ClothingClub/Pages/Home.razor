
@page "/"
@using Core
@using System.Net.Http.Json
@inject HttpClient Http

<PageTitle>Tøjklubben</PageTitle>

<div class="home-page">
    <div class="welcome-container">

        <!-- VENSTRE: Velkomsttekst -->
        <div class="welcome-text">
            <h1>Velkommen til Tøjklubben!</h1>
            <p>Del, genbrug og lån tøj med resten af klubben!</p>
        </div>

        <!-- MIDTEN: Knapper -->
        <div class="welcome-buttons">
            <button class="btn btn-primary">
                Bliv en del af klubben
            </button>

            <button class="btn btn-outline-primary">
                Tilføj tøj
            </button>
        </div>

        <!-- HØJRE: Billede -->
        <img src="images/ClothesClub.png"
             alt="Illustration af tøj"
             class="welcome-image" />

    </div>

  
    <div class="container-box">
        <!--Venstre side: Klubmedlemmer-->
        <div class="member-box">
            <h3>Klubmedlemmer</h3>
            <hr/>
            @foreach (ClubMember member in members)
            {
                <div class="member-row">
                    <span class="member-name">@member.Name</span>
                    <span class="member-email">@member.EmailAddress</span>
                </div>
            }
        </div>
        
        
        <!--Højre side: Alt tøj-->
        <div class="clothes-box">
            <h3>Alt tøj i låneklubben</h3>
            <hr/>
            <div class="clothes-grid">
                @foreach (Clothes item in clothes)
                {
                    <div class="card">
                        <div class="card-body">
                            <h5>@item.Type</h5>
                            <p>Str. @item.Size · @item.Color</p>
                            @if (item.IsBorrowed)
                            {
                                <span class="badge bg-danger">Udlånt</span>
                                <p class="due-date">
                                    Ledig igen: @item.DueDate?.ToString("dd.MM.yyyy")
                                </p>
                            }
                            else
                            {
                                <span class="badge bg-success">Ledig</span>
                                <button class="btn borrow-button"
                                        @onclick="() => ShowBorrowForm(item.ItemID)">
                                    Lån tøj
                                </button>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@code {

    // Listerne, der skal indeholde data fra backend
    private List<ClubMember> members = new();
    private List<Clothes> clothes = new();
    private int? selectedItemID = null;

    // Metoden kaldes automatisk, når siden initialiseres
    protected override async Task OnInitializedAsync()
    {
        // Henter klubmedlemmer fra backend
        members = await Http.GetFromJsonAsync<List<ClubMember>>(
            "http://localhost:5277/clubmember"
        ) ?? new();

        // Henter alt tøj fra backend
        clothes = await Http.GetFromJsonAsync<List<Clothes>>(
            "http://localhost:5277/clothes"
        ) ?? new();
    }

   /* public ClubMember registerMember(String Emailadresse, string Name, string Phonenumber)
    {
        
    }

    public Clothes addClothes(int memberID, Clothes item)
    {
        
    }
    */

   private void ShowBorrowForm(int itemID)
   {
       selectedItemID = itemID;
   }

}
